<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Strava Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --orange:   #FC4C02;
      --orange-d: #d93e00;
      --bg:       #0f0f0f;
      --surface:  #1a1a1a;
      --surface2: #242424;
      --border:   #2e2e2e;
      --text:     #f0f0f0;
      --muted:    #888;
      --radius:   10px;
    }

    body {
      font-family: 'DM Sans', system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      line-height: 1.6;
    }

    /* ── Header ── */
    header {
      border-bottom: 1px solid var(--border);
      padding: 1.1rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky; top: 0;
      background: rgba(15,15,15,.9);
      backdrop-filter: blur(12px);
      z-index: 10;
    }
    .logo { display: flex; align-items: center; gap: .5rem; font-weight: 700; font-size: 1.1rem; }
    .logo-icon { width: 28px; height: 28px; }

    /* ── Buttons ── */
    .btn {
      display: inline-flex; align-items: center; gap: .4rem;
      padding: .5rem 1.1rem; border-radius: 6px;
      font-size: .85rem; font-weight: 500;
      cursor: pointer; border: none; text-decoration: none;
      transition: filter .15s, transform .1s;
    }
    .btn:hover  { filter: brightness(1.12); }
    .btn:active { transform: scale(.97); }
    .btn-orange { background: var(--orange); color: #fff; }
    .btn-ghost  { background: var(--surface2); color: var(--text); border: 1px solid var(--border); }

    /* ── Alerts ── */
    main { max-width: 1080px; margin: 0 auto; padding: 2rem 1.5rem; }
    .alerts { margin-bottom: 1.5rem; }
    .alert { padding: .7rem 1rem; border-radius: 8px; font-size: .85rem; margin-bottom: .5rem; }
    .alert-success { background:#14301a; color:#5cdb7d; border:1px solid #1e5c31; }
    .alert-danger  { background:#2e1010; color:#e06060; border:1px solid #5c1f1f; }
    .alert-warning { background:#2e2410; color:#ddb85a; border:1px solid #5c4414; }
    .alert-info    { background:#10202e; color:#5aaed0; border:1px solid #1a4060; }

    /* ── Connect screen ── */
    .connect-screen {
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      min-height: 62vh; text-align: center; gap: 1.2rem;
    }
    .connect-screen h1 { font-size: 2rem; font-weight: 700; }
    .connect-screen p  { color: var(--muted); max-width: 400px; }
    .connect-btn {
      display: inline-flex; align-items: center; gap: .6rem;
      background: var(--orange); color: #fff;
      padding: .8rem 1.8rem; border-radius: 8px;
      font-size: 1rem; font-weight: 600; text-decoration: none;
      transition: background .15s, transform .1s;
      margin-top: .5rem;
    }
    .connect-btn:hover  { background: var(--orange-d); }
    .connect-btn:active { transform: scale(.97); }

    /* ── Athlete card ── */
    .athlete-card {
      display: flex; align-items: center; gap: 1.5rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem; margin-bottom: 2rem;
    }
    .athlete-avatar {
      width: 72px; height: 72px; border-radius: 50%;
      object-fit: cover; border: 2px solid var(--orange);
      flex-shrink: 0;
    }
    .avatar-placeholder {
      width: 72px; height: 72px; border-radius: 50%;
      background: var(--surface2); border: 2px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.8rem; flex-shrink: 0;
    }
    .athlete-info h2 { font-size: 1.3rem; font-weight: 700; }
    .athlete-info .meta { color: var(--muted); font-size: .875rem; margin-top: .2rem; }
    .athlete-info .badge {
      display: inline-block; background: var(--surface2);
      border: 1px solid var(--border);
      padding: .15rem .55rem; border-radius: 20px;
      font-size: .75rem; color: var(--muted); margin-top: .4rem;
    }

    /* ── Stats grid ── */
    .section-title {
      font-size: .7rem; font-weight: 600; letter-spacing: .1em;
      text-transform: uppercase; color: var(--muted);
      margin-bottom: 1rem;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 1rem; margin-bottom: 2.5rem;
    }
    .stat-card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 1.1rem 1.2rem;
    }
    .stat-label { font-size: .75rem; color: var(--muted); margin-bottom: .3rem; }
    .stat-value { font-size: 1.5rem; font-weight: 700; font-family: 'JetBrains Mono', monospace; }
    .stat-unit  { font-size: .75rem; color: var(--muted); margin-top: .1rem; }

    /* ── Activities table ── */
    .activities-section { margin-bottom: 2rem; }
    .table-wrap { overflow-x: auto; border-radius: var(--radius); border: 1px solid var(--border); }
    table { width: 100%; border-collapse: collapse; font-size: .875rem; }
    thead tr { background: var(--surface2); }
    th {
      text-align: left; padding: .75rem 1rem;
      font-size: .7rem; font-weight: 600;
      letter-spacing: .08em; text-transform: uppercase;
      color: var(--muted); white-space: nowrap;
    }
    tbody tr {
      border-top: 1px solid var(--border);
      transition: background .1s;
    }
    tbody tr:hover { background: var(--surface2); }
    td { padding: .75rem 1rem; vertical-align: middle; }
    .activity-type {
      display: inline-block; padding: .2rem .55rem;
      border-radius: 20px; font-size: .72rem; font-weight: 600;
      background: var(--surface2); border: 1px solid var(--border);
    }
    .activity-type.Run    { color: #5cdb7d; border-color: #1e5c31; background: #14301a; }
    .activity-type.Ride   { color: #5aaed0; border-color: #1a4060; background: #10202e; }
    .activity-type.Swim   { color: #9d7de8; border-color: #3b2870; background: #1e1535; }
    .activity-type.Walk   { color: #ddb85a; border-color: #5c4414; background: #2e2410; }
    td.mono { font-family: 'JetBrains Mono', monospace; font-size: .8rem; }
    .no-activities { text-align: center; color: var(--muted); padding: 2.5rem; }

    /* ── API endpoints reference ── */
    .endpoints { margin-top: 2.5rem; }
    .endpoint-list { display: flex; flex-direction: column; gap: .6rem; }
    .endpoint {
      display: flex; align-items: center; gap: .75rem;
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 8px; padding: .65rem 1rem; font-size: .8rem;
    }
    .method {
      font-family: 'JetBrains Mono', monospace;
      font-size: .7rem; font-weight: 600;
      background: #1a2e1a; color: #5cdb7d;
      border: 1px solid #1e5c31;
      padding: .15rem .45rem; border-radius: 4px; flex-shrink: 0;
    }
    .endpoint-path { font-family: 'JetBrains Mono', monospace; color: var(--text); }
    .endpoint-desc { color: var(--muted); margin-left: auto; font-size: .75rem; }

    footer {
      text-align: center; color: var(--muted);
      font-size: .75rem; padding: 2rem;
      border-top: 1px solid var(--border); margin-top: 3rem;
    }
  </style>
</head>
<body>

<header>
  <div class="logo">
    <svg class="logo-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M10 3L6 21M10 3L14 13M10 3L6 13M14 13L18 3M14 13L18 21" stroke="#FC4C02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    Strava Dashboard
  </div>

  {% if connected %}
    <a href="{{ url_for('strava.disconnect') }}" class="btn btn-ghost">Disconnect</a>
  {% else %}
    <a href="{{ url_for('strava.connect') }}" class="btn btn-orange">Connect Strava</a>
  {% endif %}
</header>

<main>

  <!-- Flash messages -->
  {% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}
      <div class="alerts">
        {% for category, message in messages %}
          <div class="alert alert-{{ category }}">{{ message }}</div>
        {% endfor %}
      </div>
    {% endif %}
  {% endwith %}

  <!-- ── Not connected ── -->
  {% if not connected %}
  <div class="connect-screen">
    <div style="font-size:3rem;">🚴</div>
    <h1>Connect your Strava</h1>
    <p>Authorise this app to read your Strava profile, stats, and activities.</p>
    <a href="{{ url_for('strava.connect') }}" class="connect-btn">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="white">
        <path d="M10 3L6 21M10 3L14 13M10 3L6 13M14 13L18 3M14 13L18 21" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Connect with Strava
    </a>
  </div>

  <!-- ── Connected ── -->
  {% else %}

  <!-- Athlete card -->
  <div class="athlete-card">
    {% if athlete.profile %}
      <img class="athlete-avatar" src="{{ athlete.profile }}" alt="{{ athlete.firstname }}" />
    {% else %}
      <div class="avatar-placeholder">🏃</div>
    {% endif %}
    <div class="athlete-info">
      <h2>{{ athlete.firstname }} {{ athlete.lastname }}</h2>
      <div class="meta">
        {% if athlete.city %}{{ athlete.city }}{% endif %}
        {% if athlete.city and athlete.country %}, {% endif %}
        {% if athlete.country %}{{ athlete.country }}{% endif %}
      </div>
      <span class="badge">Athlete ID: {{ athlete.id }}</span>
      {% if athlete.premium %}
        <span class="badge" style="color:#ddb85a;border-color:#5c4414;background:#2e2410;">⭐ Summit</span>
      {% endif %}
    </div>
  </div>

  <!-- Stats -->
  {% if stats %}
  <p class="section-title">All-time stats</p>
  <div class="stats-grid">
    {% set r = stats.all_run_totals %}
    <div class="stat-card">
      <div class="stat-label">🏃 Runs</div>
      <div class="stat-value">{{ r.count }}</div>
      <div class="stat-unit">activities</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">🏃 Run Distance</div>
      <div class="stat-value">{{ "%.0f"|format(r.distance / 1000) }}</div>
      <div class="stat-unit">km</div>
    </div>
    {% set b = stats.all_ride_totals %}
    <div class="stat-card">
      <div class="stat-label">🚴 Rides</div>
      <div class="stat-value">{{ b.count }}</div>
      <div class="stat-unit">activities</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">🚴 Ride Distance</div>
      <div class="stat-value">{{ "%.0f"|format(b.distance / 1000) }}</div>
      <div class="stat-unit">km</div>
    </div>
    {% set s = stats.all_swim_totals %}
    <div class="stat-card">
      <div class="stat-label">🏊 Swims</div>
      <div class="stat-value">{{ s.count }}</div>
      <div class="stat-unit">activities</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">🏆 Achievement Count</div>
      <div class="stat-value">{{ stats.recent_run_totals.achievement_count + stats.recent_ride_totals.achievement_count }}</div>
      <div class="stat-unit">recent achievements</div>
    </div>
  </div>
  {% endif %}

  <!-- Recent activities -->
  <div class="activities-section">
    <p class="section-title">Recent activities</p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Date</th>
            <th>Distance</th>
            <th>Time</th>
            <th>Elevation</th>
          </tr>
        </thead>
        <tbody>
          {% if activities %}
            {% for a in activities %}
            <tr>
              <td>{{ a.name }}</td>
              <td><span class="activity-type {{ a.type }}">{{ a.type }}</span></td>
              <td class="mono">{{ a.start_date_local[:10] }}</td>
              <td class="mono">{{ "%.2f"|format(a.distance / 1000) }} km</td>
              <td class="mono">
                {% set h = (a.moving_time // 3600) %}
                {% set m = ((a.moving_time % 3600) // 60) %}
                {% set s = (a.moving_time % 60) %}
                {% if h > 0 %}{{ h }}h {% endif %}{{ "%02d"|format(m) }}m {{ "%02d"|format(s) }}s
              </td>
              <td class="mono">{{ a.total_elevation_gain|int }} m</td>
            </tr>
            {% endfor %}
          {% else %}
            <tr><td colspan="6" class="no-activities">No activities found.</td></tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  </div>

  <!-- API reference -->
  <div class="endpoints">
    <p class="section-title">Available JSON endpoints</p>
    <div class="endpoint-list">
      <div class="endpoint">
        <span class="method">GET</span>
        <span class="endpoint-path">/strava/api/athlete</span>
        <span class="endpoint-desc">Athlete profile</span>
      </div>
      <div class="endpoint">
        <span class="method">GET</span>
        <span class="endpoint-path">/strava/api/athlete/stats</span>
        <span class="endpoint-desc">Aggregate stats</span>
      </div>
      <div class="endpoint">
        <span class="method">GET</span>
        <span class="endpoint-path">/strava/api/activities?page=1&per_page=30</span>
        <span class="endpoint-desc">Activity list</span>
      </div>
      <div class="endpoint">
        <span class="method">GET</span>
        <span class="endpoint-path">/strava/api/activities/&lt;id&gt;</span>
        <span class="endpoint-desc">Single activity detail</span>
      </div>
      <div class="endpoint">
        <span class="method">GET</span>
        <span class="endpoint-path">/strava/api/activities/&lt;id&gt;/streams</span>
        <span class="endpoint-desc">Time-series streams</span>
      </div>
      <div class="endpoint">
        <span class="method">GET</span>
        <span class="endpoint-path">/strava/api/segments/starred</span>
        <span class="endpoint-desc">Starred segments</span>
      </div>
    </div>
  </div>

  {% endif %}
</main>

<footer>Built with Flask &amp; Strava API v3</footer>
</body>
</html>