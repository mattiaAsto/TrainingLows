MAIL_SERVER = smtp.example.com
MAIL_PORT = 587
MAIL_USE_TLS = True
MAIL_USE_SSL = False

# Transactional mailbox (verification, invitations, notifications)
MAIL_TRANSACTIONAL_SENDER = service@yourdomain.ch
MAIL_SERVICE_USERNAME = service@yourdomain.ch
MAIL_SERVICE_PASSWORD = your-service-password

# Support mailbox (bug reports, admin replies)
MAIL_SUPPORT_EMAIL = support@yourdomain.ch
MAIL_SUPPORT_USERNAME = support@yourdomain.ch
MAIL_SUPPORT_PASSWORD = your-support-password

# Fallback for legacy code (usually same as transactional)
MAIL_DEFAULT_SENDER = service@yourdomain.ch
MAIL_USERNAME = service@yourdomain.ch
MAIL_PASSWORD = your-service-password

# Display name in From header
MAIL_SENDER_NAME = TrainingLows
# Optional: Brevo HTTP API key (takes priority over SMTP if set)
# With a custom domain + proper DNS records, direct SMTP works fine
